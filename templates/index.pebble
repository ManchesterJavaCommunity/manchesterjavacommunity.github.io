{% extends "base.pebble" %}

{% block body %}
            <!--
            <section class="hero is-small is-info has-shadow">
            <div class="hero-body">
                <p class="title">Welcome to the MJC</p>
                <p class="subtitle">
                    Manchester Java Community
                </p>
            </div>
            </section>
            -->

            <div class="columns">
                <div class="column">
                    <section class="message">
                        <div class="message-header">
                            Java House Sessions with Anaplan at Morson Edge
                        </div>
                        <div class="message-body">
                            <div class="columns">
                                <div class="column">
                                   <p class="pb-3">
                                        <img class="image img-style" src="https://secure.meetupstatic.com/photos/event/5/f/3/7/highres_533004375.webp?w=640" width="auto" />
                                    </p>

                                    <p class="mb-2">
                                        <strong>Date:</strong> 26th March 2026
                                    </p>

                                    <p class="mb-2">
                                        <strong>Location:</strong>
                                        <p>
                                            Morson Edge<br />
                                            Department Bonded Warehouse, 18 Lower Byrom Street, Manchester, M3 4AP
                                        </p>
                                    </p>

                                    <p class="mb-2">
                                        <strong>Talk:</strong>
                                        <p>We're excited to announce that "Java House Sessions" in partnership with <a href="https://morson-edge.com/">Morson Edge</a> is back for 2026</p>

                                        <p>We can share that our next event will be with the Java team over at Anaplan in Central Manchester.</p>

                                        <p>Full details of the talks can be found on the meetup event link below</p>
                                    </p>

                                    <p class="mb-2">
                                        <strong>Speaker:</strong>
                                        <p>Full details of the talks can be found on the meetup event link below</p>
                                    </p>

                                    <p class="mb-2">
                                        <p>Food and drink will be provided on the night, huge thanks to our hosts for their support!</p>
                                    </p>

                                    <div>
                                        <a href="https://www.meetup.com/manchesteruk-java-community/events/313416298/?utm_medium=referral&utm_campaign=share-btn_savedevents_share_modal&utm_source=link&utm_version=v2&member_id=232807783"><button class="button is-warning">Register</button></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                    <div class="column">
                     <a class="twitter-timeline" data-lang="en" data-height="750" href="https://twitter.com/mcrjava?ref_src=twsrc%5Etfw">Tweets by mcrjava</a> <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
                    </div>
                </div>
            </div>

{% endblock %}
