{% extends "base.pebble" %}

{% block body %}
            <!--
            <section class="hero is-small is-info has-shadow">
            <div class="hero-body">
                <p class="title">Welcome to the MJC</p>
                <p class="subtitle">
                    Manchester Java Community
                </p>
            </div>
            </section>
            -->

            <div class="columns">
                <div class="column">
                    <section class="message">
                        <div class="message-header">
                            Java House Sessions at N Brown Group
                        </div>
                        <div class="message-body">
                            <div class="columns">
                                <div class="column">
                                   <p class="pb-3">
                                        <img class="image img-style" src="https://secure.meetupstatic.com/photos/event/a/9/9/a/highres_527263418.webp?w=750" width="auto" />
                                    </p>

                                    <p class="mb-2">
                                        <strong>Date:</strong> 14th May 2025
                                    </p>

                                    <p class="mb-2">
                                        <strong>Location:</strong>
                                        <p>
                                            N Brown Group<br />
                                            Griffin House, 40 Lever Street, Manchester, M1 1FL
                                        </p>
                                    </p>

                                    <p class="mb-2">
                                        <strong>Talk:</strong>
                                        <p>We're excited to announce that "Java House Sessions" in partnership with <a href="https://www.interquestgroup.com/brands/ecom">ECOM</a> is back for 2025</p>

                                        <p>We can share that our next event will be with the Java team over at N Brown Group in Central Manchester.</p>

                                        <p>Full details of the talks to follow</p>
                                    </p>

                                    <p class="mb-2">
                                        <strong>Speaker:</strong>
                                        <p>Details of the speakers to follow</p>
                                    </p>

                                    <p class="mb-2">
                                        <p>Food and drink will be provided on the night, huge thanks to our hosts <a href="https://www.nbrown.co.uk/">N Brown Group</a> for their support!</p>
                                    </p>

                                    <div>
                                        <a href="https://www.meetup.com/manchesteruk-java-community/events/307191674/?utm_medium=referral&utm_campaign=share-btn_savedevents_share_modal&utm_source=link"><button class="button is-warning">Register</button></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                    <div class="column">
                     <a class="twitter-timeline" data-lang="en" data-height="750" href="https://twitter.com/mcrjava?ref_src=twsrc%5Etfw">Tweets by mcrjava</a> <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
                    </div>
                </div>
            </div>

{% endblock %}
